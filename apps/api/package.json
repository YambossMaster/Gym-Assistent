{
  "name": "@gym-assistant/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "beta:operator": "node --env-file=.env --import tsx src/beta-admission/operator.ts",
    "check": "npm run typecheck && npm test",
    "dev": "node --watch --env-file=.env --import tsx src/start.ts",
    "e2e:m1": "node --env-file=.env.e2e --import tsx src/e2e/run-m1-live.ts",
    "e2e:password": "node --env-file=.env --env-file=.env.e2e --import tsx src/e2e/run-password-live.ts",
    "e2e:beta": "node --env-file=.env --env-file=.env.e2e --import tsx src/e2e/run-beta-admission-live.ts",
    "e2e:m3": "node --env-file=.env.e2e --import tsx src/e2e/run-m3-live.ts",
    "e2e:m4": "node --env-file=.env.e2e --import tsx src/e2e/run-m4-live.ts",
    "e2e:m5": "node --env-file=.env.e2e --import tsx src/e2e/run-m5-live.ts",
    "e2e:m6": "node --env-file=.env.e2e --import tsx src/e2e/run-m6-live.ts",
    "e2e:m7": "node --env-file=.env.e2e --import tsx src/e2e/run-m7-live.ts",
    "e2e:m7.5-venue": "node --env-file=.env.e2e --import tsx src/e2e/run-venue-model-live.ts",
    "fixture:beta-browser": "node --env-file=.env --env-file=.env.e2e --import tsx src/e2e/beta-browser-fixture.ts",
    "fixture:training-browser": "node --env-file=.env.e2e --import tsx src/e2e/training-browser-fixture.ts",
    "migration:preview:m3": "node --import tsx src/migration/preview-demo-student-entitlement.ts",
    "migration:preview:m4": "node --import tsx src/migration/preview-demo-scheduling.ts",
    "preview:m5": "node --import tsx src/migration/run-preview-m5-training.ts",
    "start": "node dist/start.js",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
