NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Required in Production. Keep every value in the host secret store.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gym_assistant
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
BETA_ADMISSION_SECRET=replace-with-unique-32-plus-character-secret
EXPECTED_SUPABASE_PROJECT_REF=replace-with-20-character-project-ref
SUPABASE_JWT_AUDIENCE=authenticated
# Recommended in Production so the public-link rate-limit key can rotate independently.
CAPABILITY_RATE_LIMIT_SECRET=replace-with-independent-32-plus-character-secret
# Feature-required in Production. Missing preserves API startup but disables create/reset/recovery.
CALENDAR_SUBSCRIPTION_SECRET=replace-with-43-character-base64url-secret
# Local checkout only. Keep disabled until the billing migration is installed on Development.
BILLING_LOCAL_CHECKOUT=false
BILLING_RETURN_URL=http://127.0.0.1:5173/settings/checkout
# Server-only Test Mode credentials and variant mapping; never use VITE_ for these.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_PRO_MONTH_VARIANT=
LEMON_PRO_YEAR_VARIANT=
LEMON_PRIME_MONTH_VARIANT=
LEMON_PRIME_YEAR_VARIANT=
# Keep both off: merchant testing is deferred by the Product Owner.
# Lifecycle also requires the separately prepared billing_event_ledger migration.
BILLING_LOCAL_LIFECYCLE=false
BILLING_PROVIDER_TESTS_APPROVED=false
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Dedicated server worker connection with gym_billing_worker privileges; never a browser key.
BILLING_WORKER_DATABASE_URL=
