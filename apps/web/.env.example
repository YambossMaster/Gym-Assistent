VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional override; blank uses the published Chinese feedback form.
VITE_FEEDBACK_FORM_URL=
VITE_SUPPORT_EMAIL=
VITE_INTERNAL_ALPHA=false
# DEV frontend is available by default. Opt in to HTTP checkout only when its API is ready.
# Keep false while merchant verification is deferred.
VITE_LOCAL_BILLING=false
# Production build switch. Keep false until the R17 Live release gate.
VITE_BILLING_LIVE=false
