# Copy this template for another Fly app. The production app uses fly.production.toml.
app = "replace-with-your-fly-app"
primary_region = "nrt"

[http_service]
internal_port = 3000
force_https = true
auto_stop_machines = "off"
auto_start_machines = true

[[http_service.checks]]
grace_period = "15s"
interval = "30s"
method = "GET"
timeout = "10s"
path = "/api/ready"
