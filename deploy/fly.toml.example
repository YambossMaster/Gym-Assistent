# Copy to a private release configuration and replace the app name before deployment.
app = "replace-with-your-fly-app"
primary_region = "sin"

[http_service]
internal_port = 3000
force_https = true
auto_stop_machines = "off"
auto_start_machines = false

[[http_service.checks]]
grace_period = "15s"
interval = "30s"
method = "GET"
timeout = "10s"
path = "/api/ready"
